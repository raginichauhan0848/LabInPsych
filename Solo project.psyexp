  <Flow>
    <LoopInitiator loopType="TrialHandler" name="trials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'study_word': 'dog-bone'}, {'study_word': 'cat-bat'}, {'study_word': 'sun-moon'}, {'study_word': 'bread-butter'}, {'study_word': 'pen-paper'}, {'study_word': 'car-road'}, {'study_word': 'cry-baby'}, {'study_word': 'cow-milk'}, {'study_word': 'music-song'}, {'study_word': 'winter-snow'}, {'study_word': 'flower-garden'}, {'study_word': 'spoon-fork'}, {'study_word': 'chair-table'}, {'study_word': 'lock-key'}, {'study_word': 'salt-pepper'}, {'study_word': 'teacher-student'}, {'study_word': 'candle-cake'}, {'study_word': 'train-station'}, {'study_word': 'grocery-bag'}, {'study_word': 'hand-finger'}, {'study_word': 'phone-call'}, {'study_word': 'bird-fly'}, {'study_word': 'apple-fruit'}, {'study_word': 'screw-driver'}, {'study_word': 'star-sky'}, {'study_word': 'lemon-wallet'}, {'study_word': 'pilot-knife'}, {'study_word': 'mirror-truck'}, {'study_word': 'axe-leaf'}, {'study_word': 'box-floor'}, {'study_word': 'tree-soup'}, {'study_word': 'boat-dirt'}, {'study_word': 'desk-wall'}, {'study_word': 'hat-book'}, {'study_word': 'knee-gum'}, {'study_word': 'door-coin'}, {'study_word': 'bed-gold'}, {'study_word': 'shoe-fence'}, {'study_word': 'fish-belt'}, {'study_word': 'button-hole'}, {'study_word': 'shirt-juice'}, {'study_word': 'mop-cloud'}, {'study_word': 'cube-glasses'}, {'study_word': 'cap-map'}, {'study_word': 'curtain-bin'}, {'study_word': 'wave-stool'}, {'study_word': 'logo-pan '}, {'study_word': 'light-page'}, {'study_word': 'reservoir-building'}, {'study_word': 'ceiling-charger'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="studywords solo project.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
